# Spring Boot 3 生产级（production）Docker 运行时环境变量示例
# 使用前请按需复制为 .env（切勿将含真实凭据的 .env 提交至版本库）

# 时区设置（默认显式采用亚洲/上海）
TZ=Asia/Shanghai

# 业务服务端口与独立管理端口隔离配置
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

# Tomcat 临时工作目录
TOMCAT_BASEDIR=/tmp/tomcat

# 容器内存感知 JVM 参数（根据容器实际限额按需调整）
JAVA_OPTS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# 应用元信息摘要
APP_NAME=spring-boot-jar-app
APP_ENV=production
APP_MESSAGE=Spring Boot 3 参考应用（生产级）

# 可观测性（默认关闭 OTLP 导出；仅当配置有效 Collector 地址时按需启用）
OTEL_EXPORTER_OTLP_ENDPOINT=

# 单应用交付边界示例：外部有状态依赖统一通过环境变量注入（占位符）
# EXTERNAL_API_URL=https://api.example.internal
# DATABASE_URL=jdbc:postgresql://db.example.internal:5432/app_db
# DATABASE_USERNAME=YOUR_DB_USERNAME
# DATABASE_PASSWORD=YOUR_DB_PASSWORD
