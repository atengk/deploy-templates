# Spring Boot 3 企业加固级（hardened）宿主机运行时环境变量示例
# 建议安装路径：/etc/spring-boot-jar/app.env
# 建议文件权限：chown root:springapp /etc/spring-boot-jar/app.env && chmod 0640 /etc/spring-boot-jar/app.env

# 时区设置
TZ=Asia/Shanghai

# 仅绑定宿主机回环网卡，强制业务流量经过前置 Nginx 反代、管理端口仅限本机探针/采集代理访问
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_SERVER_ADDRESS=127.0.0.1

# 配合 systemd PrivateTmp=yes 与 ProtectSystem=strict 的私有临时目录
TOMCAT_BASEDIR=/tmp/tomcat

# 与 systemd MemoryMax=768M 协同的 JVM 内存感知参数
JAVA_OPTS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp -Djava.security.egd=file:/dev/./urandom

# 应用元信息摘要
APP_NAME=spring-boot-jar-app
APP_ENV=hardened
APP_MESSAGE=Spring Boot 3 参考应用（企业加固级宿主机）

# 可观测性（默认关闭 OTLP 导出；仅当配置有效 Collector 地址时按需启用）
OTEL_EXPORTER_OTLP_ENDPOINT=

# 单应用交付边界示例：外部有状态依赖统一通过环境变量注入（占位符）
# EXTERNAL_API_URL=https://api.example.internal
# DATABASE_URL=jdbc:postgresql://db.example.internal:5432/app_db
# DATABASE_USERNAME=YOUR_DB_USERNAME
# DATABASE_PASSWORD=YOUR_DB_PASSWORD
