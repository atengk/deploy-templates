# Spring Boot 3 快速级（quickstart）宿主机运行时环境变量示例
# 建议安装路径：/etc/spring-boot-jar/app.env
# 建议文件权限：chmod 0640 /etc/spring-boot-jar/app.env

# 时区设置
TZ=Asia/Shanghai

# 快速级采用单端口同时提供业务接口与 /actuator/health 端点
SERVER_PORT=8080

# 内嵌 Tomcat 临时工作目录
TOMCAT_BASEDIR=/tmp/spring-boot-jar-tomcat

# JVM 运行参数（可根据宿主机内存按需调整）
JAVA_OPTS=-Xms128m -Xmx512m

# 应用元信息摘要
APP_NAME=spring-boot-jar-app
APP_ENV=quickstart
APP_MESSAGE=Spring Boot 3 参考应用（快速级宿主机）

# 可观测性（默认关闭 OTLP 导出；仅当配置有效 Collector 地址时按需启用）
OTEL_EXPORTER_OTLP_ENDPOINT=

# 单应用交付边界示例：外部有状态依赖统一通过环境变量注入（占位符）
# EXTERNAL_API_URL=https://api.example.internal
# DATABASE_URL=jdbc:postgresql://db.example.internal:5432/app_db
# DATABASE_USERNAME=YOUR_DB_USERNAME
# DATABASE_PASSWORD=YOUR_DB_PASSWORD
