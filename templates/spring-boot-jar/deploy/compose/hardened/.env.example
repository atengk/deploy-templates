# 企业加固级（hardened）Spring Boot 3 Docker Compose 参数示例（零明文凭据）
# 使用前请复制为 .env（切勿将含真实凭据的 .env 提交至版本库），或通过 --env-file .env.example 传入

# 时区设置（默认显式采用亚洲/上海）
TZ=Asia/Shanghai

# 宿主机映射业务端口与容器业务/管理端口（管理端口仅限容器内部 JDK 探针与内网隔离访问，不向宿主机映射）
APP_PORT=8080
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

# 只读根文件系统（read_only: true）下的 Tomcat 临时目录（配合 tmpfs /tmp 使用）
TOMCAT_BASEDIR=/tmp/tomcat

# 应用元信息摘要与构建注入版本号
APP_NAME=spring-boot-jar-app
APP_VERSION=0.1.0-SNAPSHOT
APP_ENV=hardened
APP_MESSAGE=Spring Boot 3 参考应用（企业加固级）

# 可观测性（默认关闭 OTLP 导出；仅当配置有效 Collector 地址时按需启用）
# 可选启用示例：OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.example.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# 可选国内加速源（仅在执行本地构建时生效，默认使用官方上游源）
BASE_IMAGE_REGISTRY=docker.io
GCR_REGISTRY=gcr.io
MAVEN_MIRROR_URL=

# 单应用交付边界示例：外部有状态依赖统一通过环境变量注入（占位符）
# EXTERNAL_API_URL=https://api.example.internal
# DATABASE_URL=jdbc:postgresql://db.example.internal:5432/app_db
# DATABASE_USERNAME=YOUR_DB_USERNAME
# DATABASE_PASSWORD=YOUR_DB_PASSWORD
