# 企业加固级（hardened）宿主机部署与运行时注入配置示例（零明文凭据）
# 线上建议放置于 /etc/vue3-pnpm/app.env（权限建议 0640 root:nginx 或 0600 root:root）
TZ=Asia/Shanghai
DEPLOY_ROOT=/opt/vue3-pnpm
NGINX_PORT=80

# 健康检查探测地址与发布后自动闭环校验开关
HEALTHCHECK_URL=http://127.0.0.1:80/healthz
AUTO_HEALTHCHECK=false

# 加固发布治理策略：历史版本保留数量与静态资源只读权限收敛
KEEP_RELEASES=5
DEPLOY_DIR_MODE=0755
DEPLOY_FILE_MODE=0644
# 生产宿主机建议取消注释并指定属主（例如 root:nginx 或 root:www-data），使 Nginx 工作进程仅有只读权限
# DEPLOY_OWNER=root:nginx

# 运行时注入前端配置（由 deploy.sh 读取并安全转义生成至 releases/<version>/config.js）
APP_TITLE=Vue 3 参考应用（企业加固级）
# 默认由 deploy.sh 自动注入本次发布版本号；仅需显式覆盖时取消下方注释
# APP_VERSION=1.0.0
APP_ENV=production
APP_API_BASE_URL=https://api.example.com
