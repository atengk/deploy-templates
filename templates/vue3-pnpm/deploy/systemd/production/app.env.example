# 生产级（production）宿主机部署与运行时注入配置示例（零明文凭据）
# 线上建议放置于 /etc/vue3-pnpm/app.env（权限建议 0640 root:nginx 或 root:www-data）
TZ=Asia/Shanghai
DEPLOY_ROOT=/opt/vue3-pnpm
NGINX_PORT=80

# 健康检查探测地址（healthcheck.sh 未单独设置时按 NGINX_PORT 自动拼接）
HEALTHCHECK_URL=http://127.0.0.1:80/healthz

# 运行时注入前端配置（由 deploy.sh 读取并安全转义生成至 releases/<version>/config.js）
APP_TITLE=Vue 3 参考应用（生产级）
# 留空或保持注释时默认由 deploy.sh 注入本次发布版本号（未设置发布版本时保留构建期 VITE_APP_VERSION）；仅需显式覆盖时填写非空值
# APP_VERSION=
APP_ENV=production
APP_API_BASE_URL=https://api.example.com
