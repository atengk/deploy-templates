# 企业加固级（hardened）Docker Compose 构建与运行时配置注入参数示例（零明文凭据）
TZ=Asia/Shanghai
APP_PORT=8080

# 运行时注入前端配置（在只读根文件系统模式下写入 /tmp/app-runtime/config.js）
APP_TITLE=Vue 3 参考应用（企业加固级）
APP_VERSION=0.0.0-dev
APP_ENV=production
APP_API_BASE_URL=https://api.example.com

# 可选国内加速源（仅在执行本地构建时生效，默认使用官方上游源）
BASE_IMAGE_REGISTRY=docker.io
PNPM_REGISTRY=https://registry.npmjs.org
