# 生产级（production）Docker Compose 构建与运行时配置注入参数示例（零明文凭据）
TZ=Asia/Shanghai
APP_PORT=8080

# 运行时注入前端配置（无需重新构建镜像即可按环境覆盖）
APP_TITLE=Vue 3 参考应用（生产级）
# 留空或保持注释则保留镜像构建时注入的 VITE_APP_VERSION；仅需显式覆盖时填写非空值
# APP_VERSION=
APP_ENV=production
APP_API_BASE_URL=https://api.example.com

# 可选国内加速源（仅在执行本地构建时生效，默认使用官方上游源）
BASE_IMAGE_REGISTRY=docker.io
PNPM_REGISTRY=https://registry.npmjs.org
